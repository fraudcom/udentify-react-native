<resources>

    <!-- Base application theme.

         MaterialComponents rather than React Native's default AppCompat: the
         Udentify NFC repeat popup (udentify_nfc_repeat_popup) inflates a
         com.google.android.material MaterialButton, which throws
         "The style on this component requires your app theme to be
         Theme.MaterialComponents (or a descendant)" under an AppCompat theme and
         takes the app down. MaterialComponents descends from AppCompat, so
         everything else keeps working. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

</resources>
