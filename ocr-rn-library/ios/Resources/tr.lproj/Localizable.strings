/* Card Classification — current SDK key names
   ------------------------------------------------------------------
   UdentifyOCR looks these eight keys up under the `udentify_ocr_`
   prefix. The `udentifyocr_` block above uses the older spelling and is
   no longer read by the SDK; it is kept for now in case anything else
   still depends on it. To retire it, delete that block and nothing
   here changes.

   The five keys in the old block with no entry here — card_generic,
   id_card, drivers_license, instruction_success, footer_success — are
   not looked up by the SDK under either spelling, so they are not
   duplicated.

   Values are Udentify's own, supplied 2026-09-28. They were first
   copied from the old block; four of the Turkish instruction strings
   differed in wording and were replaced with the vendor's. Do not
   re-derive them from the block above. */

"udentify_ocr_classification_instruction_unidentified" = "Belge algılanamadı. Lütfen çerçeve içinde geçerli bir %@ tarayıp tekrar deneyin.";
"udentify_ocr_classification_instruction_mismatch" = "Belge uyuşmuyor. Lütfen çerçeve içinde geçerli bir %@ tarayıp tekrar deneyin.";
"udentify_ocr_classification_instruction_mismatch_front" = "Belge uyuşmuyor. Lütfen %@ ön yüzünü çerçeveye düzgün hizalayıp tekrar deneyin.";
"udentify_ocr_classification_instruction_mismatch_back" = "Belge uyuşmuyor. Lütfen %@ arka yüzünü çerçeveye düzgün hizalayıp tekrar deneyin.";
